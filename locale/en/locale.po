msgid "plugins.importexport.csv.help.users"
msgstr "Import user accounts with roles and subscriptions. The CSV file should contain columns for user information such as username, email, first name, last name, and role assignments."

msgid "plugins.importexport.csv.help.issues"
msgstr "Import journal issues and articles with metadata, files, and publication details. The CSV file should contain columns for issue and article information including titles, abstracts, authors, and file paths."

msgid "plugins.importexport.csv.help.users.detailed"
msgstr "Import user accounts with comprehensive profile information, role assignments, and subscription details. Your CSV file should include columns such as username, email, first name, last name, affiliation, country, journal path, and role. Users will be created with encrypted passwords and can be assigned to specific journals and roles. Enable the welcome email option to automatically notify new users of their account creation."

msgid "plugins.importexport.csv.help.issues.detailed"
msgstr "Import complete journal issues including articles, metadata, and associated files. Your CSV file should contain detailed information about each article including title, abstract, authors, keywords, DOI, publication dates, and file paths. The system will automatically create issues, articles, publications, and link all associated files. Ensure all referenced files exist in your source directory before importing."

msgid "plugins.importexport.csv.help.fileFormat"
msgstr "CSV File Format Requirements"

msgid "plugins.importexport.csv.help.fileFormat.description"
msgstr "CSV files must be properly formatted with UTF-8 encoding and comma-separated values. The first row should contain column headers that match the expected field names. For examples and detailed field specifications, check the plugin documentation and example files in the plugin directory."

msgid "plugins.importexport.csv.fileUploadHint"
msgstr "Drag and drop your CSV file here, or click to browse. Only CSV files are accepted."

