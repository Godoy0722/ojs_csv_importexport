msgid "plugins.importexport.csv.displayName"
msgstr "CSV Import Plugin"

msgid "plugins.importexport.csv.description"
msgstr "Import issues or users through a CSV file."

msgid "plugins.importexport.csv.cliUsage"
msgstr "Command-line tool for importing issues or users through a CSV file.\n"
"Usage:\n"
"{$scriptName} [users|issues] username [pathToCsvFile] <sendWelcomeEmail> [--subscription-type <typeId>]\n"
"Choose one of the following options:\n"
" - users - import users from CSV file\n"
" - issues - import issues from CSV file\n\n"
"username - the username of the user to whom imported issues should be assigned.\n"
"pathToCsvFile - the path to the CSV file to be imported.\n"
"sendWelcomeEmail - optional parameter, if set to true, a welcome email will be sent to the imported users.\n"
"--subscription-type <typeId> - optional parameter for user import, adds subscriptions with the specified type ID."

msgid "plugins.importexport.csv.cliUsage.examples"
msgstr "Examples:\n"
"{$scriptName} users admin /home/user/import_files/users.csv\n"
"{$scriptName} issues admin /home/user/import_files/issues.csv\n"
"{$scriptName} users admin /home/user/import_files/users.csv true\n"
"{$scriptName} issues admin /home/user/import_files/issues.csv true\n"
"{$scriptName} users admin /home/user/import_files/users.csv true --subscription-type 1\n"

